{
  "name": "wisp-cli",
  "version": "0.3.0",
  "description": "A small, provider-agnostic coding agent for your terminal",
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "openai": "^7.53.0",
    "picocolors": "^1.1.1",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "wisp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
